{
  "name": "@acertainromance401/design-mcp",
  "version": "0.2.0",
  "description": "Portable design MCP with general UI/UX guidance, SwiftUI/web examples and project references",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acertainromance401/DESIGN.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "design-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "content",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:swift": "node scripts/verify-swift.mjs",
    "import:guides": "node scripts/import-guides.mjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
