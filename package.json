{
  "name": "@acertainromance401/design-mcp",
  "version": "0.3.0",
  "description": "Portable design MCP with general UI/UX guidance, SwiftUI/web examples and project references",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acertainromance401/DESIGN.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "design-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "content",
    "examples",
    "docs/aesthetic.html",
    "docs/black-minimal.html",
    "docs/black-editorial.html",
    "docs/sports-collage.html",
    "docs/sports-collage.md",
    "docs/boxing-overhead.html",
    "docs/boxing-vintage.html",
    "docs/boxing-arena.html",
    "docs/boxing-references.md",
    "docs/assets/sports-soccer-cc0.jpg",
    "docs/high-energy.html",
    "docs/color-combinations.html",
    "docs/color-combinations.md",
    "docs/mood-examples.html",
    "docs/mood-examples.md",
    "docs/screen-effects.html",
    "docs/screen-effects.md",
    "docs/assets/aesthetic-preview.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:swift": "node scripts/verify-swift.mjs",
    "import:guides": "node scripts/import-guides.mjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
