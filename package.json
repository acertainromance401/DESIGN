{
  "name": "@acertainromance401/design-mcp",
  "version": "0.4.0",
  "description": "Portable design MCP with visual technology discovery and web, SwiftUI, Metal and game adoption guidance",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acertainromance401/DESIGN.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "design-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "content",
    "examples",
    "designs/editorial",
    "designs/references",
    "designs/posters",
    "designs/palettes",
    "designs/effects",
    "designs/spatial",
    "designs/characters",
    "designs/shared",
    "designs/index.html",
    "designs/README.md",
    "designs/celebration/README.md",
    "docs/design-inventory.md",
    "docs/platform-adoption.md",
    "docs/technology-catalog.md",
    "docs/mcp-workflows.md",
    "docs/workspace-map.md",
    "docs/analyses",
    "docs/recording-analyses.md",
    "scripts/prepare-birthday-model.mjs",
    "scripts/prepare-birthday-vendor.mjs",
    "docs/design-principles.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "verify:swift": "node scripts/verify-swift.mjs",
    "docs:designs": "npm run build && node scripts/build-design-docs.mjs",
    "analysis:new": "npm run build && node scripts/manage-analysis.mjs new",
    "analysis:save": "npm run build && node scripts/manage-analysis.mjs save",
    "analysis:check": "npm run build && node scripts/manage-analysis.mjs check",
    "import:guides": "node scripts/import-guides.mjs",
    "prepare:birthday": "node scripts/prepare-birthday-vendor.mjs",
    "prepare:birthday-model": "node scripts/prepare-birthday-model.mjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "three": "0.180.0",
    "typescript": "^5.9.0"
  }
}
